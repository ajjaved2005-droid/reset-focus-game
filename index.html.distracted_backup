/* ---- Toast & Flash ---- */
function toast(msg, type = '') {
  const el = document.getElementById('penalty-toast');
  if (!el) return;
  el.textContent = msg;
  el.className = 'show' + (type ? ' ' + type : '');
  if (G.toastTO) clearTimeout(G.toastTO);
  G.toastTO = setTimeout(() => el.className = '', 1800);
}
function flash(color) {
  const el = document.getElementById('game-flash');
  if (!el) return;
  el.style.background = color;
  el.classList.add('show');
  if (G.flashTO) clearTimeout(G.flashTO);
  G.flashTO = setTimeout(() => el.classList.remove('show'), 200);
}

/* ---- Penalties ---- */
function addOT(amount, msg, type) {
  G.overThink = Math.min(100, G.overThink + amount);
  updMeter();
  if (msg) toast(msg, type || 'warn');
  if (G.overThink >= 100) endGame('focus');
}
function timePenalty(s) {
  G.timer = Math.max(0, G.timer - s);
  updTimer();
  if (G.timer <= 0) endGame('time');
}

/* ---- BFS to find shortest path (used to protect critical route) ---- */
function bfs(startR, startC, endR, endC, R, C, cells, blocked) {
  const q = [{ r: startR, c: startC, path: [ck(startR, startC)] }];
  const visited = new Set([ck(startR, startC)]);
  if (blocked) blocked.forEach(k => visited.add(k));
  while (q.length) {
    const { r, c, path } = q.shift();
    if (r === endR && c === endC) return path;
    for (const d of ['N', 'S', 'E', 'W']) {
      if (cells[r][c].walls[d]) continue;
      const [dr, dc] = DIRS[d], nr = r + dr, nc = c + dc;
      const nk = ck(nr, nc);
      if (inB(nr, nc, R, C) && !visited.has(nk)) {
        visited.add(nk);
        q.push({ r: nr, c: nc, path: [...path, nk] });
      }
    }
  }
  return null;
}

/* ---- Level Init ---- */
function initLevel(lvl) {
  const cfg = LEVELS[lvl - 1];
  G.level = lvl;
  G.rows = cfg.rows;
  G.cols = cfg.cols;
  G.timer = cfg.time;
  G.overThink = 0;
  G.wrongChoices = 0;
  G.enemyHits = 0;
  G.visitedCells = new Set();
  G.repeatedCells = 0;
  G.deadEndsSeen = new Set();
  G.deadEndCount = 0;
  G.enemies = [];
  G.traps = new Set();
  G.falseExits = new Set();
  G.wrongObjs = new Set();
  G.pendingDir = null;
  G.running = false;
  G.player = { r: 0, c: 0, tr: 0, tc: 0, t: 1, moving: false, cooldown: 0 };

  G.cells = genMaze(cfg.rows, cfg.cols, cfg.loopPct);
  G.exitCell = { r: cfg.rows - 1, c: cfg.cols - 1 };

  // Find the critical shortest path — never place hazards on it to guarantee reachability!
  const critPath = bfs(0, 0, cfg.rows - 1, cfg.cols - 1, cfg.rows, cfg.cols, G.cells, null);
  const critSet = new Set(critPath || []);

  // Collect safe placement cells (not on critical path, not start, not exit)
  const free = [];
  for (let r = 0; r < cfg.rows; r++) {
    for (let c = 0; c < cfg.cols; c++) {
      const k = ck(r, c);
      if (critSet.has(k)) continue;
      if (r === 0 && c === 0) continue;
      if (r === cfg.rows - 1 && c === cfg.cols - 1) continue;
      free.push({ r, c });
    }
  }
  rShuffle(free);

  // False exits — placed on boundary cells not on critical path
  const bdry = free.filter(({ r, c }) => r === 0 || r === cfg.rows - 1 || c === 0 || c === cfg.cols - 1);
  rShuffle(bdry);
  for (let i = 0; i < Math.min(cfg.falseExits, bdry.length); i++) {
    G.falseExits.add(ck(bdry[i].r, bdry[i].c));
  }

  // Traps + wrong objects — placed on non-critical cells
  const inner = free.filter(({ r, c }) => !G.falseExits.has(ck(r, c)));
  rShuffle(inner);
  let fi = 0;
  for (let i = 0; i < Math.min(cfg.traps, inner.length - fi); i++) {
    G.traps.add(ck(inner[fi].r, inner[fi].c));
    fi++;
  }
  for (let i = 0; i < Math.min(cfg.wrongObjs, inner.length - fi); i++) {
    G.wrongObjs.add(ck(inner[fi].r, inner[fi].c));
    fi++;
  }

  // Enemies — placed on non-critical cells, patrolling paths
  const eStarts = inner.slice(fi).filter(({ r, c }) => !G.traps.has(ck(r, c)) && !G.wrongObjs.has(ck(r, c)));
  rShuffle(eStarts);
  const pLen = [5, 8, 12][lvl - 1];
  for (let i = 0; i < Math.min(cfg.enemies, eStarts.length); i++) {
    const { r: er, c: ec } = eStarts[i];
    const path = buildPatrol(G.cells, er, ec, cfg.rows, cfg.cols, pLen);
    if (path.length < 2) continue;
    G.enemies.push({ path, pi: 0, dir: 1, r: path[0].r, c: path[0].c, tr: path[1].r, tc: path[1].c, t: 0, speed: cfg.speed, hitCD: 0 });
  }

  document.getElementById('hud-level').textContent = cfg.label;
  updAttemptHud();
  updTimer();
  updMeter();
  G.visitedCells.add(ck(0, 0));
  resizeCv();
  setupTouchControls();
}

/* ---- Canvas sizing ---- */
function resizeCv() {
  const wrap = document.querySelector('.game-canvas-wrap');
  const cv = document.getElementById('game-canvas');
  if (!wrap || !cv) return;
  const topbar = document.querySelector('.game-topbar');
  const topbarH = topbar ? topbar.offsetHeight : 52;
  const availW = Math.max(220, Math.min(wrap.clientWidth, window.innerWidth) - 16);
  const availH = Math.max(220, window.innerHeight - topbarH - 18);
  const sz = Math.floor(Math.min(availW, availH));
  G.cSize = Math.max(12, Math.floor(sz / Math.max(G.cols, 1)));
  cv.width = G.cSize * G.cols;
  cv.height = G.cSize * G.rows;
}
window.addEventListener('resize', () => {
  if (document.getElementById('game-screen').classList.contains('active')) resizeCv();
});

/* ---- Mobile Touch & Swipe Controls ---- */
let touchStartX = 0;
let touchStartY = 0;
let touchStartTime = 0;
let swipeHandled = false;

function setupTouchControls() {
  if (G.touchSetupDone) return;
  const cv = document.getElementById('game-canvas');
  const wrap = document.querySelector('.game-canvas-wrap');
  if (!cv || !wrap) return;

  function onTouchStart(e) {
    if (!G.running) return;
    if (e.touches.length > 1) return; // Prevent multi-touch zoom interference
    e.preventDefault();
    const t = e.touches[0];
    touchStartX = t.clientX;
    touchStartY = t.clientY;
    touchStartTime = performance.now();
    swipeHandled = false;
  }

  function onTouchMove(e) {
    if (!G.running || swipeHandled) return;
    e.preventDefault();
    const t = e.touches[0];
    const dx = t.clientX - touchStartX;
    const dy = t.clientY - touchStartY;
    const dist = Math.hypot(dx, dy);

    // Minimum swipe threshold (20px) to prevent accidental micro-movements
    if (dist >= 20) {
      swipeHandled = true; // Prevents a single swipe from triggering multiple unintended movements!
      if (Math.abs(dx) > Math.abs(dy)) {
        queueMove(dx > 0 ? 'E' : 'W');
      } else {
        queueMove(dy > 0 ? 'S' : 'N');
      }
    }
  }

  function onTouchEnd(e) {
    if (!G.running) return;
    e.preventDefault();
    // If no swipe triggered during the gesture, treat it as a directional tap relative to player
    if (!swipeHandled && e.changedTouches && e.changedTouches.length > 0) {
      const t = e.changedTouches[0];
      const elapsed = performance.now() - touchStartTime;
      const totalDist = Math.hypot(t.clientX - touchStartX, t.clientY - touchStartY);

      if (elapsed < 500 && totalDist < 18) {
        const rect = cv.getBoundingClientRect();
        const tapX = t.clientX - rect.left;
        const tapY = t.clientY - rect.top;
        const playerScreenX = (G.player.c + 0.5) * G.cSize;
        const playerScreenY = (G.player.r + 0.5) * G.cSize;
        const dX = tapX - playerScreenX;
        const dY = tapY - playerScreenY;

        if (Math.abs(dX) > 6 || Math.abs(dY) > 6) {
          if (Math.abs(dX) > Math.abs(dY)) {
            queueMove(dX > 0 ? 'E' : 'W');
          } else {
            queueMove(dY > 0 ? 'S' : 'N');
          }
        }
      }
    }
    swipeHandled = false;
  }

  cv.addEventListener('touchstart', onTouchStart, { passive: false });
  cv.addEventListener('touchmove', onTouchMove, { passive: false });
  cv.addEventListener('touchend', onTouchEnd, { passive: false });
  cv.addEventListener('touchcancel', () => { swipeHandled = false; }, { passive: false });
  wrap.addEventListener('touchmove', (e) => { e.preventDefault(); }, { passive: false });

  G.touchSetupDone = true;
}

/* ---- Movement ---- */
function queueMove(dir) { G.pendingDir = dir; }

function tryMove(dir) {
  const { r, c } = G.player;
  if (G.cells[r][c].walls[dir]) return false;
  const [dr, dc] = DIRS[dir], nr = r + dr, nc = c + dc;
  if (!inB(nr, nc, G.rows, G.cols)) return false;
  G.player.tr = nr;
  G.player.tc = nc;
  G.player.t = 0;
  G.player.moving = true;
  return true;
}

function completeMove() {
  G.player.r = G.player.tr;
  G.player.c = G.player.tc;
  G.player.moving = false;
  const k = ck(G.player.r, G.player.c);

  // Check loops / repeated visits
  if (G.visitedCells.has(k)) {
    G.repeatedCells++;
    if (G.repeatedCells % 3 === 0) addOT(8, '⟳ OVERTHINKING LOOP +8%', 'warn');
  }
  G.visitedCells.add(k);

  // Check dead ends (a cell with 3 walls, excluding start and exit)
  const cell = G.cells[G.player.r][G.player.c];
  const openCount = ['N', 'S', 'E', 'W'].filter(d => !cell.walls[d]).length;
  const isStart = G.player.r === 0 && G.player.c === 0;
  const isExit = G.player.r === G.exitCell.r && G.player.c === G.exitCell.c;
  if (openCount === 1 && !isStart && !isExit) {
    if (!G.deadEndsSeen.has(k)) {
      G.deadEndsSeen.add(k);
      G.deadEndCount++;
      addOT(7, '⛔ DEAD END +7%', 'warn');
    }
  }

  // Hazards
  if (G.traps.has(k)) {
    G.wrongChoices++;
    addOT(15, '⚠ TRAP! +15% −3s', 'danger');
    timePenalty(3);
    flash('rgba(232,120,48,.22)');
    G.traps.delete(k);
    return;
  }
  if (G.wrongObjs.has(k)) {
    G.wrongChoices++;
    addOT(12, '✗ DISTRACTION +12%', 'warn');
    G.wrongObjs.delete(k);
    flash('rgba(255,202,40,.28)');
    return;
  }
  if (G.falseExits.has(k)) {
    G.wrongChoices++;
    addOT(20, '✗ FALSE EXIT +20% −5s', 'danger');
    timePenalty(5);
    flash('rgba(229,57,53,.2)');
    return;
  }

  // Exit reached
  if (G.player.r === G.exitCell.r && G.player.c === G.exitCell.c) {
    levelWon();
  }
}

/* ---- Enemies ---- */
function updEnemies(dt) {
  for (const en of G.enemies) {
    if (en.hitCD > 0) en.hitCD -= dt;
    en.t += dt * en.speed;
    if (en.t >= 1) {
      en.t = 1;
      en.r = en.tr;
      en.c = en.tc;
      let np = en.pi + en.dir;
      if (np < 0 || np >= en.path.length) {
        en.dir *= -1;
        np = en.pi + en.dir;
      }
      if (np >= 0 && np < en.path.length) {
        en.pi = np;
        en.tr = en.path[np].r;
        en.tc = en.path[np].c;
        en.t = 0;
      }
    }
    if (en.hitCD <= 0) {
      const er = en.r + (en.tr - en.r) * en.t, ec = en.c + (en.tc - en.c) * en.t;
      const pr = G.player.r + (G.player.tr - G.player.r) * G.player.t, pc = G.player.c + (G.player.tc - G.player.c) * G.player.t;
      if (Math.sqrt((er - pr) ** 2 + (ec - pc) ** 2) < 0.68) {
        G.enemyHits++;
        en.hitCD = 1.5;
        G.player.cooldown = 0.45;
        addOT(18, '⚡ THOUGHT COLLISION +18%', 'danger');
        timePenalty(2);
        flash('rgba(229,57,53,.28)');
      }
    }
  }
}

/* ---- Timer ---- */
function startTimer() {
  if (G.timerInterval) clearInterval(G.timerInterval);
  G.timerInterval = setInterval(() => {
    if (!G.running) return;
    G.timer -= 0.5;
    updTimer();
    if (G.timer <= 0) {
      clearInterval(G.timerInterval);
      G.timerInterval = null;
      endGame('time');
    }
  }, 500);
}

/* ---- Game Loop ---- */
function startLoop() {
  G.running = true;
  G.lastTS = 0;
  if (G.raf) cancelAnimationFrame(G.raf);
  G.raf = requestAnimationFrame(gameLoop);
}
function gameLoop(ts) {
  if (!G.running) return;
  const dt = G.lastTS ? Math.min((ts - G.lastTS) / 1000, 0.1) : 0;
  G.lastTS = ts;
  if (G.player.moving) {
    G.player.t += dt * 9;
    if (G.player.t >= 1) {
      G.player.t = 1;
      completeMove();
    }
  } else if (G.pendingDir && G.player.cooldown <= 0) {
    tryMove(G.pendingDir);
    G.pendingDir = null;
  }
  if (G.player.cooldown > 0) G.player.cooldown -= dt;
  updEnemies(dt);
  drawGame();
  G.raf = requestAnimationFrame(gameLoop);
}

/* ---- Draw ---- */
function drawGame() {
  const cv = document.getElementById('game-canvas');
  if (!cv) return;
  const ctx = cv.getContext('2d'), cs = G.cSize;
  ctx.clearRect(0, 0, cv.width, cv.height);
  ctx.fillStyle = '#fff';
  ctx.fillRect(0, 0, cv.width, cv.height);

  // Visited tint
  ctx.fillStyle = 'rgba(46,205,166,.05)';
  G.visitedCells.forEach(k => {
    const r = Math.floor(k / 1000), c = k % 1000;
    if (r < G.rows && c < G.cols) ctx.fillRect(c * cs + 1, r * cs + 1, cs - 2, cs - 2);
  });

  // Traps
  G.traps.forEach(k => {
    const r = Math.floor(k / 1000), c = k % 1000, x = c * cs, y = r * cs;
    ctx.fillStyle = 'rgba(232,120,48,.15)';
    ctx.fillRect(x + 2, y + 2, cs - 4, cs - 4);
    ctx.strokeStyle = 'rgba(232,120,48,.7)';
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.moveTo(x + cs * 0.25, y + cs * 0.25);
    ctx.lineTo(x + cs * 0.75, y + cs * 0.75);
    ctx.moveTo(x + cs * 0.75, y + cs * 0.25);
    ctx.lineTo(x + cs * 0.25, y + cs * 0.75);
    ctx.stroke();
  });

  // Wrong objects / Distractions
  G.wrongObjs.forEach(k => {
    const r = Math.floor(k / 1000), c = k % 1000;
    const bx = c * cs + cs * 0.3, by = r * cs + cs * 0.3, bs = cs * 0.4;
    ctx.fillStyle = 'rgba(255,202,40,.8)';
    ctx.fillRect(bx, by, bs, bs);
    ctx.strokeStyle = '#152B4A';
    ctx.lineWidth = 1.5;
    ctx.strokeRect(bx, by, bs, bs);
    ctx.fillStyle = '#152B4A';
    ctx.font = 'bold ' + Math.floor(cs * 0.24) + 'px Space Grotesk,sans-serif';
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    ctx.fillText('?', c * cs + cs * 0.5, r * cs + cs * 0.5);
  });

  // False exits
  G.falseExits.forEach(k => {
    const r = Math.floor(k / 1000), c = k % 1000;
    ctx.fillStyle = 'rgba(232,120,48,.12)';
    ctx.fillRect(c * cs + 3, r * cs + 3, cs - 6, cs - 6);
    ctx.strokeStyle = 'rgba(232,120,48,.6)';
    ctx.lineWidth = 2;
    ctx.setLineDash([3, 3]);
    ctx.strokeRect(c * cs + 4, r * cs + 4, cs - 8, cs - 8);
    ctx.setLineDash([]);
    ctx.fillStyle = 'rgba(232,120,48,.8)';
    ctx.font = 'bold ' + Math.floor(cs * 0.17) + 'px Space Grotesk,sans-serif';
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    ctx.fillText('EXIT?', c * cs + cs * 0.5, r * cs + cs * 0.5);
  });

  // Real exit
  if (G.exitCell) {
    const { r, c } = G.exitCell;
    ctx.fillStyle = 'rgba(46,205,166,.18)';
    ctx.fillRect(c * cs + 2, r * cs + 2, cs - 4, cs - 4);
    ctx.strokeStyle = '#2ECDA6';
    ctx.lineWidth = 3;
    ctx.strokeRect(c * cs + 3, r * cs + 3, cs - 6, cs - 6);
    ctx.fillStyle = '#2ECDA6';
    ctx.font = 'bold ' + Math.floor(cs * 0.19) + 'px Space Grotesk,sans-serif';
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    ctx.fillText('EXIT', c * cs + cs * 0.5, r * cs + cs * 0.5);
  }

  // Start marker
  ctx.fillStyle = 'rgba(33,150,243,.08)';
  ctx.fillRect(2, 2, cs - 4, cs - 4);

  // Walls
  ctx.strokeStyle = '#152B4A';
  ctx.lineWidth = 2.5;
  ctx.lineCap = 'square';
  for (let r = 0; r < G.rows; r++) {
    for (let c = 0; c < G.cols; c++) {
      const w = G.cells[r][c].walls, x = c * cs, y = r * cs;
      ctx.beginPath();
      if (w.N) { ctx.moveTo(x, y); ctx.lineTo(x + cs, y); }
      if (w.S) { ctx.moveTo(x, y + cs); ctx.lineTo(x + cs, y + cs); }
      if (w.E) { ctx.moveTo(x + cs, y); ctx.lineTo(x + cs, y + cs); }
      if (w.W) { ctx.moveTo(x, y); ctx.lineTo(x, y + cs); }
      ctx.stroke();
    }
  }
  ctx.strokeStyle = '#152B4A';
  ctx.lineWidth = 3;
  ctx.strokeRect(0, 0, cv.width, cv.height);

  // Enemies
  const now = performance.now() / 1000;
  for (const en of G.enemies) {
    const er = en.r + (en.tr - en.r) * en.t, ec = en.c + (en.tc - en.c) * en.t;
    const ex = ec * cs, ey = er * cs, es = cs * 0.54, eo = (cs - es) / 2;
    const pulse = 0.6 + 0.4 * Math.sin(now * 3.5 + en.pi);
    ctx.shadowColor = 'rgba(229,57,53,.4)';
    ctx.shadowBlur = 7 * pulse;
    ctx.fillStyle = '#1a1a2e';
    ctx.fillRect(ex + eo, ey + eo, es, es);
    ctx.shadowBlur = 0;
    ctx.fillStyle = 'rgba(229,57,53,' + (0.7 + 0.3 * pulse) + ')';
    const es2 = es * 0.14, ey2 = ey + eo + es * 0.3;
    ctx.fillRect(ex + eo + es * 0.22, ey2, es2, es2);
    ctx.fillRect(ex + eo + es * 0.64, ey2, es2, es2);
  }

  // Player (The Overthinker)
  const pr = G.player.r + (G.player.tr - G.player.r) * G.player.t;
  const pc = G.player.c + (G.player.tc - G.player.c) * G.player.t;
  const ps = cs * 0.9, po = (cs - ps) / 2;
  const px = pc * cs + po, py = pr * cs + po;
  ctx.strokeStyle = 'rgba(33,150,243,.4)';
  ctx.lineWidth = 2;
  ctx.strokeRect(pc * cs + 2, pr * cs + 2, cs - 4, cs - 4);
  if (G.playerImg && G.playerImg.complete && G.playerImg.naturalWidth > 0) {
    ctx.drawImage(G.playerImg, px, py, ps, ps);
  } else {
    ctx.fillStyle = '#2196F3';
    ctx.fillRect(px, py, ps, ps);
  }
}

/* ---- Level Won ---- */
function levelWon() {
  G.running = false;
  if (G.timerInterval) { clearInterval(G.timerInterval); G.timerInterval = null; }
  if (G.raf) { cancelAnimationFrame(G.raf); G.raf = null; }

  const timeUsed = LEVELS[G.level - 1].time - Math.max(0, G.timer);
  G.levelStats.push({
    level: G.level,
    timeTaken: timeUsed,
    timeRemaining: Math.ceil(G.timer),
    wrongChoices: G.wrongChoices,
    deadEnds: G.deadEndCount,
    repeatedCells: G.repeatedCells,
    enemyHits: G.enemyHits,
    overThink: Math.round(G.overThink)
  });

  document.getElementById('lc-title').textContent = G.level < 3 ? 'LEVEL ' + G.level + ' COMPLETE' : 'LEVEL 3 OVERCOME!';
  document.getElementById('lc-attempt-tag').textContent = '✓ Cleared on Attempt ' + G.levelAttempt + ' of 2';
  document.getElementById('lc-time').textContent = Math.ceil(G.timer) + 's';
  document.getElementById('lc-wrong').textContent = G.wrongChoices;
  document.getElementById('lc-hits').textContent = G.enemyHits;
  document.getElementById('lc-meter').textContent = Math.round(G.overThink) + '%';

  const btn = document.getElementById('lc-next-btn');
  if (G.level >= 3) {
    btn.textContent = 'VIEW FINAL RESULTS →';
    btn.onclick = showFinalScore;
  } else {
    btn.textContent = 'NEXT LEVEL →';
    btn.onclick = nextLevel;
  }
  showScreen('game-screen', 'level-complete-screen', 400);
}

/* ---- Strict Two-Attempt System ---- */
function endGame(reason) {
  G.running = false;
  if (G.timerInterval) { clearInterval(G.timerInterval); G.timerInterval = null; }
  if (G.raf) { cancelAnimationFrame(G.raf); G.raf = null; }

  const isTime = reason === 'time';
  document.getElementById('go-icon').textContent = isTime ? '⏱' : '🌀';
  document.getElementById('go-m-fill').style.width = Math.round(G.overThink) + '%';

  const retryBtn = document.getElementById('go-retry-btn');
  const restartBtn = document.getElementById('go-restart-btn');
  const badge = document.getElementById('go-badge');
  const msgEl = document.getElementById('go-attempt-msg');

  if (G.levelAttempt === 1) {
    // First failure on this level: Allow exactly 1 retry
    badge.textContent = 'ATTEMPT 1 OF 2 FAILED';
    badge.className = 'go-badge';
    document.getElementById('go-title').textContent = isTime ? 'TIME RAN OUT' : 'YOU LOST FOCUS';
    document.getElementById('go-sub').textContent = isTime
      ? 'The pressure of time overwhelmed your decision-making.'
      : 'Overthinking filled the meter and broke your focus.';
    msgEl.innerHTML = 'You have <strong>1 retry remaining</strong> for Level ' + G.level + '. Take a breath, trust your next step, and try again.';
    retryBtn.style.display = 'inline-flex';
    restartBtn.style.display = 'none';
  } else {
    // Second failure on this level: Strictly end current run, no 3rd attempt
    badge.textContent = 'RUN OVER — ATTEMPT 2 OF 2 FAILED';
    badge.className = 'go-badge danger';
    document.getElementById('go-title').textContent = 'BOTH ATTEMPTS USED';
    document.getElementById('go-sub').textContent = 'You have used both attempts for Level ' + G.level + '. This run has ended.';
    msgEl.innerHTML = 'Overthinking loops take practice to break. You can restart the challenge from <strong>Level 1</strong> or return to persona selection.';
    retryBtn.style.display = 'none';
    restartBtn.style.display = 'inline-flex';
  }

  showScreen('game-screen', 'game-over-screen', 400);
}

function nextLevel() {
  const nextLvl = G.level + 1;
  // Starting a new level grants that level its own two fresh attempts!
  G.levelAttempt = 1;
  showScreen('level-complete-screen', 'game-screen', 500);
  setTimeout(() => {
    initLevel(nextLvl);
    startTimer();
    startLoop();
  }, 620);
}

function retryLevel() {
  // Second attempt for the current level
  G.levelAttempt = 2;
  showScreen('game-over-screen', 'game-screen', 500);
  setTimeout(() => {
    initLevel(G.level);
    startTimer();
    startLoop();
  }, 620);
}

function restartGame() {
  // Full reset from Level 1
  G.level = 1;
  G.levelAttempt = 1;
  G.levelStats = [];
  showScreen('game-over-screen', 'game-instructions-screen', 500);
}

function startGame() {
  // Genuinely new game run begins
  G.level = 1;
  G.levelAttempt = 1;
  G.levelStats = [];
  showScreen('game-instructions-screen', 'game-screen', 600);
  setTimeout(() => {
    initLevel(1);
    startTimer();
    startLoop();
  }, 720);
}

function playAgain() {
  // Genuinely new game run begins from results or guidance screen
  G.level = 1;
  G.levelAttempt = 1;
  G.levelStats = [];
  const activeScreen = document.getElementById('guidance-screen').classList.contains('active')
    ? 'guidance-screen'
    : 'final-score-screen';
  showScreen(activeScreen, 'game-screen', 500);
  setTimeout(() => {
    initLevel(1);
    startTimer();
    startLoop();
  }, 620);
}

/* ---- Score Calculation & Results Experiences ---- */
function calcRunScores() {
  const totalTimeTaken = G.levelStats.reduce((sum, s) => sum + s.timeTaken, 0);
  const totalWrong = G.levelStats.reduce((sum, s) => sum + s.wrongChoices, 0);
  const totalDeadEnds = G.levelStats.reduce((sum, s) => sum + s.deadEnds, 0);
  const totalLoops = G.levelStats.reduce((sum, s) => sum + s.repeatedCells, 0);
  const totalHits = G.levelStats.reduce((sum, s) => sum + s.enemyHits, 0);

  // Overthinking Score components (normalized to 0 - 100):
  // 1. Wrong turns, false exits, distractions: up to 35 pts
  const wrongScore = Math.min(35, totalWrong * 4.5);
  // 2. Dead ends & hesitation loops: up to 25 pts
  const loopScore = Math.min(25, (totalDeadEnds * 2.5) + (totalLoops * 1.0));
  // 3. Enemy thought collisions: up to 20 pts
  const hitScore = Math.min(20, totalHits * 4.0);
  // 4. Time ratio penalty (hesitation / slowness): up to 20 pts
  const timeRatio = Math.min(1, totalTimeTaken / 135);
  const timeScore = timeRatio * 20;

  let overthinkingScore = Math.round(wrongScore + loopScore + hitScore + timeScore);
  overthinkingScore = Math.max(0, Math.min(100, overthinkingScore));

  // Focus & Control Score (0 - 100):
  // Distinct score measuring decision clarity and execution
  const focusScore = Math.max(0, Math.min(100, 100 - overthinkingScore));

  return {
    overthinkingScore,
    focusScore,
    totalTimeTaken,
    totalWrong,
    totalDeadEnds,
    totalLoops,
    totalHits
  };
}

function showFinalScore() {
  const scores = calcRunScores();
  const ot = scores.overthinkingScore;
  const fc = scores.focusScore;

  // Display numbers
  document.getElementById('fs-ot-score').innerHTML = ot + '<span class="fs-score-out"> / 100</span>';
  document.getElementById('fs-fc-score').innerHTML = fc + '<span class="fs-score-out"> / 100</span>';
  document.getElementById('fs-ot-bar').style.width = ot + '%';
  document.getElementById('fs-fc-bar').style.width = fc + '%';

  // Badges
  const otBadge = document.getElementById('fs-ot-badge');
  if (ot <= 30) {
    otBadge.textContent = '0–30 LOWER';
    otBadge.className = 'fs-score-badge badge-ot-low';
  } else if (ot <= 60) {
    otBadge.textContent = '31–60 MODERATE';
    otBadge.className = 'fs-score-badge badge-ot-mod';
  } else {
    otBadge.textContent = '61–100 HIGHER';
    otBadge.className = 'fs-score-badge badge-ot-high';
  }

  const fcBadge = document.getElementById('fs-fc-badge');
  if (fc >= 70) {
    fcBadge.textContent = 'HIGH CONTROL';
    fcBadge.className = 'fs-score-badge badge-fc-high';
  } else {
    fcBadge.textContent = 'MODERATE CONTROL';
    fcBadge.className = 'fs-score-badge badge-fc-med';
  }

  // Branch results experiences: Lower Overthinking (0 - 30) vs Moderate/Higher (> 30)
  const titleEl = document.getElementById('fs-title');
  const msgEl = document.getElementById('fs-message');
  const quoteEl = document.getElementById('fs-quote');
  const guidanceBtn = document.getElementById('fs-guidance-btn');

  if (ot <= 30) {
    titleEl.textContent = 'YOU FOUND YOUR WAY.';
    msgEl.textContent = 'You made thoughtful decisions and navigated the maze with control. Keep practising patience, trust in your decisions, and focused thinking.';
    const qIndex = Math.floor(Math.random() * LOW_OT_QUOTES.length);
    quoteEl.textContent = '"' + LOW_OT_QUOTES[qIndex] + '"';
    guidanceBtn.textContent = 'CONTINUE YOUR RESET →';
  } else {
    titleEl.textContent = 'YOUR MIND NEEDS A RESET.';
    msgEl.textContent = "Some routes made you stop, reconsider, or repeat your steps. That happens. The goal isn't to control every thought; it's to learn which thoughts deserve your energy.";
    const qIndex = Math.floor(Math.random() * HIGH_OT_QUOTES.length);
    quoteEl.textContent = '"' + HIGH_OT_QUOTES[qIndex] + '"';
    guidanceBtn.textContent = 'LEARN TO RESET →';
  }

  // Breakdown statistics
  document.getElementById('fs-time-total').textContent = Math.round(scores.totalTimeTaken) + 's / 135s';
  document.getElementById('fs-wrong').textContent = scores.totalWrong;
  document.getElementById('fs-loops').textContent = scores.totalDeadEnds + scores.totalLoops;
  document.getElementById('fs-hits').textContent = scores.totalHits;

  showScreen('level-complete-screen', 'final-score-screen', 450);
}

function openGuidanceScreen() {
  showScreen('final-score-screen', 'guidance-screen', 450);
}
