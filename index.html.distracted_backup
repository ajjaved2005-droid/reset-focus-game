  touchSetupDone: false
};

// Preload player image
const _pImg = new Image();
_pImg.src = 'overthinker.png';
G.playerImg = _pImg;

/* ---- Maze helpers ---- */
const DIRS = { N: [-1, 0], S: [1, 0], E: [0, 1], W: [0, -1] };
const OPP = { N: 'S', S: 'N', E: 'W', W: 'E' };
function inB(r, c, R, C) { return r >= 0 && r < R && c >= 0 && c < C; }
function rShuffle(a) { for (let i = a.length - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1)); [a[i], a[j]] = [a[j], a[i]]; } return a; }
function ck(r, c) { return r * 1000 + c; }

function buildGrid(R, C) {
  return Array.from({ length: R }, (_, r) => Array.from({ length: C }, (_, c) => ({ r, c, walls: { N: 1, S: 1, E: 1, W: 1 }, vis: false })));
}
function carveDFS(g, r, c, R, C) {
  g[r][c].vis = true;
  for (const d of rShuffle(['N', 'S', 'E', 'W'])) {
    const [dr, dc] = DIRS[d], nr = r + dr, nc = c + dc;
    if (inB(nr, nc, R, C) && !g[nr][nc].vis) {
      g[r][c].walls[d] = 0;
      g[nr][nc].walls[OPP[d]] = 0;
      carveDFS(g, nr, nc, R, C);
    }
  }
}
function addLoops(g, R, C, pct) {
  for (let r = 0; r < R; r++) {
    for (let c = 0; c < C; c++) {
      if (Math.random() < pct) {
        for (const d of rShuffle(['S', 'E'])) {
          const [dr, dc] = DIRS[d], nr = r + dr, nc = c + dc;
          if (inB(nr, nc, R, C) && g[r][c].walls[d]) {
            g[r][c].walls[d] = 0;
            g[nr][nc].walls[OPP[d]] = 0;
            break;
          }
        }
      }
    }
  }
}
function genMaze(R, C, pct) {
  const g = buildGrid(R, C);
  carveDFS(g, 0, 0, R, C);
  addLoops(g, R, C, pct);
  return g;
}

function buildPatrol(g, sr, sc, R, C, len) {
  const path = [{ r: sr, c: sc }];
  let r = sr, c = sc;
  for (let i = 0; i < len - 1; i++) {
    const open = rShuffle(['N', 'S', 'E', 'W']).filter(d => {
      const [dr, dc] = DIRS[d], nr = r + dr, nc = c + dc;
      return inB(nr, nc, R, C) && !g[r][c].walls[d];
    });
    if (!open.length) break;
    const [dr, dc] = DIRS[open[0]];
    r += dr; c += dc;
    if ((r === 0 && c === 0) || (r === R - 1 && c === C - 1)) break;
    path.push({ r, c });
  }
  return path;
}

/* ---- HUD ---- */
function updTimer() {
  const el = document.getElementById('hud-timer');
  if (!el) return;
  el.textContent = Math.max(0, Math.ceil(G.timer));
  el.classList.toggle('danger', G.timer <= 8);
}
function updMeter() {
  const f = document.getElementById('hud-m-fill'), p = document.getElementById('hud-m-pct');
  if (!f || !p) return;
  const v = Math.round(G.overThink);
  f.style.width = v + '%';
  f.className = 'hud-m-fill' + (v >= 75 ? ' crit' : v >= 45 ? ' warn' : '');
  p.textContent = v + '%';
}
function updAttemptHud() {
  const el = document.getElementById('hud-attempt');
  if (!el) return;
  el.textContent = 'ATTEMPT ' + G.levelAttempt + '/2';
  el.classList.toggle('second-attempt', G.levelAttempt === 2);
