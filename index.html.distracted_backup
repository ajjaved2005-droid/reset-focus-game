  procrastinator:{ name:'THE PROCRASTINATOR', img:'procrastinator.png', desc:'Always waiting for the "right moment" that never comes. This mindset delays, distracts, and watches deadlines fly by while scrolling through feeds.',      color:'#E87830' },
  distracted:    { name:'THE DISTRACTED',     img:'distracted.png',     desc:"Pulled in every direction by notifications, tabs, and conversations. This mindset can't hold focus for more than a few minutes before switching tasks.",        color:'#2ECDA6' },
  focused:       { name:'THE FOCUSED ONE',    img:'focused.png',        desc:'Locked in and laser-sharp. This mindset knows how to prioritize, block distractions, and get into deep work mode — but staying here is the real challenge.', color:'#00C853' }
};
let selectedChar = null;

function createPixelDecor() {
  const c = document.getElementById('pixel-decor');
  const cols = ['#152B4A','#2ECDA6','#2196F3','#E87830','#FFCA28','#00C853'];
  const n = window.innerWidth < 640 ? 14 : 28;
  for (let i=0;i<n;i++) {
    const p = document.createElement('div'); p.className='pix';
    const s = Math.random()*6+3;
    Object.assign(p.style,{ width:s+'px', height:s+'px', left:(Math.random()*96+2)+'%', top:(Math.random()*96+2)+'%', background:cols[Math.floor(Math.random()*cols.length)], animationDelay:(Math.random()*20)+'s', animationDuration:(Math.random()*12+16)+'s' });
    c.appendChild(p);
  }
}
createPixelDecor();

function showScreen(hideId, showId, delay) {
  const ov = document.getElementById('transition-overlay');
  ov.classList.add('active');
  setTimeout(() => {
    document.getElementById(hideId).classList.remove('active','fade-in');
    const el = document.getElementById(showId);
    el.classList.add('active','fade-in');
    if (showId==='coming-soon-screen') {
      const bar = el.querySelector('.cs-progress-bar');
      if (bar) { bar.style.animation='none'; bar.offsetHeight; bar.style.animation=''; }
    }
    setTimeout(()=>ov.classList.remove('active'),350);
  }, delay||600);
}

function enterGame() { showScreen('welcome-screen','selection-screen',600); }

function selectCharacter(card) {
  const key = card.dataset.char;
  const data = charData[key]; if (!data) return;
  document.querySelectorAll('.char-card').forEach(c=>c.classList.remove('selected'));
  card.classList.add('selected'); selectedChar = key;
  const si = document.getElementById('sel-img');
  si.src=data.img; si.alt=data.name;
  si.style.animation='none'; si.offsetHeight; si.style.animation='';
  document.getElementById('sel-name').textContent = data.name;
  document.getElementById('sel-desc').textContent = data.desc;
  document.getElementById('selection-panel').classList.add('visible');
  if (window.innerWidth<=768) setTimeout(()=>document.getElementById('selection-panel').scrollIntoView({behavior:'smooth',block:'center'}),180);
}

/* MODIFIED: Overthinker → game; others → coming soon */
function startChallenge() {
  if (!selectedChar) return;
  if (selectedChar==='overthinker') {
    showScreen('selection-screen','game-instructions-screen',700);
  } else {
    const ci = document.getElementById('cs-char-img');
    ci.src=charData[selectedChar].img; ci.alt=charData[selectedChar].name;
    showScreen('selection-screen','coming-soon-screen',700);
  }
}
function goBack() { showScreen('coming-soon-screen','selection-screen',500); }

function goBackToSelection() {
  G.running = false;
  if (G.timerInterval) { clearInterval(G.timerInterval); G.timerInterval = null; }
  if (G.raf) { cancelAnimationFrame(G.raf); G.raf = null; }
  ['game-instructions-screen','game-screen','level-complete-screen','game-over-screen','final-score-screen','guidance-screen']
    .forEach(id => {
      const el = document.getElementById(id);
      if (el) el.classList.remove('active','fade-in');
    });
  document.getElementById('welcome-screen').classList.remove('active','fade-in');
  const ov = document.getElementById('transition-overlay');
  ov.classList.add('active');
  setTimeout(() => {
    document.getElementById('selection-screen').classList.add('active','fade-in');
    setTimeout(() => ov.classList.remove('active'), 350);
  }, 450);
}

document.addEventListener('keydown', e => {
  const gs = document.getElementById('game-screen');
  const ws = document.getElementById('welcome-screen');
  const ss = document.getElementById('selection-screen');
  const cs = document.getElementById('coming-soon-screen');
  if (ws.classList.contains('active') && (e.key === 'Enter' || e.key === ' ')) { e.preventDefault(); enterGame(); return; }
  if (ss.classList.contains('active')) {
    const cards = Array.from(document.querySelectorAll('.char-card'));
    if (e.key >= '1' && e.key <= '4') { const i = parseInt(e.key) - 1; if (cards[i]) selectCharacter(cards[i]); }
    if (e.key === 'Enter' && selectedChar) startChallenge();
  }
  if (cs.classList.contains('active') && e.key === 'Escape') goBack();
  if (gs.classList.contains('active') && G.running) {
    const m = { ArrowUp:'N', ArrowDown:'S', ArrowLeft:'W', ArrowRight:'E', w:'N', s:'S', a:'W', d:'E', W:'N', S:'S', A:'W', D:'E' };
    if (m[e.key]) { e.preventDefault(); queueMove(m[e.key]); }
  }
});

